NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL="mysql://root:password@localhost:3306/track_ai"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/callback/google
# Generate each secret independently: openssl rand -hex 64
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
# Production always enables Secure. For HTTPS development set true.
# Secure cookies use SameSite=None for GitHub Pages + Render; HTTP local uses Strict.
COOKIE_SECURE=false
UPLOAD_DIR=uploads
# MP3/WAV only. Must be greater than 0 and at most 100 MiB.
MAX_UPLOAD_MB=50
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# External calls are disabled by default. Mock fixtures require explicit opt-in.
AI_PROVIDER_MODE=unconfigured
VERIFICATION_TIMEOUT_MS=30000
PAYMENT_PROVIDER_MODE=unconfigured
# Local Metadata JSON. Default: UPLOAD_DIR/metadata
METADATA_DIR=uploads/metadata
# Local RPC receipts are verified. User wallets submit transactions.
BLOCKCHAIN_NETWORK=unconfigured
# Actual adapter is restricted to local Hardhat 31337.
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
TRACK_REGISTRY_ADDRESS=""
LICENSE_NFT_ADDRESS=""
LICENSE_MARKETPLACE_ADDRESS=""
REVENUE_SPLITTER_ADDRESS=""
BLOCKCHAIN_START_BLOCK=0
EIP712_DOMAIN_NAME=TrackAI_Registry
EIP712_DOMAIN_VERSION=1
EIP712_PRIMARY_TYPE=RegisterTrack
EIP712_FIELD_ORDER=audioHash,metadataCIDHash,registrant,contributorsHash,similarityScore,modelVersion,nonce,deadline
# Local adapter requires exact TrackRegistry types and default hashing.
EIP712_FIELD_TYPES_JSON='{}'
EIP712_HASHING_JSON='{}'
VERIFICATION_SIGNER_ADDRESS=""
VERIFICATION_SIGNER_PRIVATE_KEY=""
REGISTRATION_TTL_SECONDS=900
BLOCKCHAIN_CONFIRMATIONS=2


# Real local service adapters (AI/api/server.py and Kubo RPC)
# AI_PROVIDER_MODE=http
AI_API_URL=http://127.0.0.1:8000
TRACK_AI_API_KEY=""
# Use up to 600000ms for long local inference. No timeout is treated as PASS.
STORAGE_PROVIDER_MODE=unconfigured
IPFS_API_URL=http://127.0.0.1:5001
