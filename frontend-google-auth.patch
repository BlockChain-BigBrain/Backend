e:13px;line-height:1.7;background:#fff0e8;padding:12px;border-radius:8px;color:#8a3c21}footer{border-top:1px solid #dde5d8;padding-top:24px;color:#6b776e;font-size:11px;display:flex;justify-content:space-between}button:disabled{opacity:.6;cursor:wait}a:focus-visible,button:focus-visible{outline:3px solid #79a853;outline-offset:4px}@media(max-width:760px){main{padding:24px}.tag{display:none}.layout{grid-template-columns:1fr;gap:28px;padding:42px 0}h1{font-size:42px}.wave{display:none}.card{padding:28px}footer{gap:20px;font-size:10px}}
diff --git a/tests/auth.test.ts b/tests/auth.test.ts
new file mode 100644
index 0000000..cbf658c
--- /dev/null
+++ b/tests/auth.test.ts
@@ -0,0 +1,25 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createAuthClient,AuthError} from '../src/auth';
+const json=(body:unknown,status=200)=>new Response(JSON.stringify(body),{status});
+test('cookie restore, Bearer header and shared parallel refresh',async()=>{
+ let refreshes=0;
+ const client=createAuthClient('http://localhost:3000',async(url,init)=>{
+  assert.equal(init?.credentials,'include');
+  if(String(url).endsWith('/refresh')){refreshes++;await new Promise(r=>setTimeout(r,10));return json({accessToken:'access'});}
+  assert.equal(new Headers(init?.headers).get('Authorization'),'Bearer access');return json({id:1});
+ });
