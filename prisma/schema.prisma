generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ContributionRole {
  PROMPT
  EDIT
  COMPOSER
  VOCAL
  PRODUCER
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LicenseType {
  PERSONAL
  COMMERCIAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum RegistrationStatus {
  NOT_REGISTERED
  PENDING
  REGISTERED
  FAILED
}

enum RiskStatus {
  PASS
  WARN
  HOLD
}

enum VerificationSource {
  UNCONFIGURED
  MOCK
  AI
}

// UNKNOWN preserves legacy amounts without guessing their currency.
enum Currency {
  UNKNOWN
  KRW
  USD
  ETH
  MATIC
}

enum ListingStatus {
  PREPARING
  ACTIVE
  INACTIVE
}

enum LicenseStatus {
  PENDING_PAYMENT
  PENDING_MINT
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  LICENSE_PURCHASE
  REVENUE_WITHDRAWAL
}

enum WithdrawalStatus {
  PREPARING
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProofSource {
  UNCONFIGURED
  MOCK
  REAL
}

enum PreparationStatus {
  PREPARED
  UPLOADED
  FAILED
}

enum PurchaseStatus {
  PENDING_PAYMENT
  PENDING_MINT
  COMPLETED
  SIMULATED
  FAILED
  CANCELLED
}

model User {
  id                  Int                  @id @default(autoincrement())
  refreshTokenHash    String?              @db.VarChar(64)
  googleId            String?              @unique
  provider            AuthProvider         @default(GOOGLE)
  passwordHash        String?
  preferredLanguage   String               @default("ko")
  email               String               @unique
  name                String
  profileImage        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  walletAddress       String?              @unique @db.VarChar(42)
  marketplaceListings MarketplaceListing[]
  revenueAllocations  RevenueAllocation[]
  revenueWithdrawals  RevenueWithdrawal[]
  purchaseRequests    PurchaseRequest[]
  walletChallenge     WalletChallenge?
  tracks              Track[]              @relation("TrackOwner")
  contributions       Contribution[]
  licenses            License[]
  transactions        Transaction[]
}

model Track {
  id                        Int                   @id @default(autoincrement())
  title                     String
  isPublic                  Boolean               @default(true)
  prompt                    String?               @db.Text
  workLog                   String?               @db.Text
  audioPath                 String
  mimeType                  String
  ownerId                   Int
  audioHash                 String?               @db.VarChar(64)
  fileSize                  BigInt?               @db.UnsignedBigInt
  duration                  Decimal?              @db.Decimal(12, 3)
  metadataCid               String?               @db.VarChar(255)
  audioCid                  String?               @db.VarChar(255)
  registrationStatus        RegistrationStatus    @default(NOT_REGISTERED)
  blockchainTrackId         String?               @db.VarChar(78)
  registeredAt              DateTime?
  registrationTxHash        String?               @db.VarChar(66)
  contributionsFinalizedAt  DateTime?
  marketplaceListings       MarketplaceListing[]
  metadataSnapshots         MetadataSnapshot[]
  registrationRequests      RegistrationRequest[]
  purchaseRequests          PurchaseRequest[]
  comparedSimilarityResults SimilarityResult[]    @relation("ComparedTrack")
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  owner                     User                  @relation("TrackOwner", fields: [ownerId], references: [id])
  contributions             Contribution[]
  verifications             Verification[]
  similarityResults         SimilarityResult[]
  licenses                  License[]
  transactions              Transaction[]

  @@index([ownerId, createdAt])
  @@index([isPublic, createdAt])
  @@index([audioHash])
  @@index([registrationStatus])
}

model Contribution {
  id         Int              @id @default(autoincrement())
  trackId    Int
  userId     Int
  role       ContributionRole
  percentage Decimal          @db.Decimal(5, 2)
  track      Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id])

  @@unique([trackId, userId, role])
  @@index([userId])
}

model Verification {
  id                Int                @id @default(autoincrement())
  trackId           Int
  status            VerificationStatus @default(PENDING)
  source            VerificationSource @default(UNCONFIGURED)
  duplicate         Boolean?
  riskScore         Decimal?           @db.Decimal(5, 4)
  riskStatus        RiskStatus?
  modelVersion      String?
  verifiedAt        DateTime?
  errorCode         String?
  errorMessage      String?            @db.Text
  similarityResults SimilarityResult[]
  fingerprint       String?            @db.Text
  message           String?            @db.Text
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  track             Track              @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([trackId, createdAt])
  @@index([trackId, status])
}

model SimilarityResult {
  id              Int           @id @default(autoincrement())
  trackId         Int
  verificationId  Int?
  comparedTrackId Int?
  verification    Verification? @relation(fields: [verificationId], references: [id], onDelete: SetNull)
  comparedTrack   Track?        @relation("ComparedTrack", fields: [comparedTrackId], references: [id], onDelete: SetNull)
  comparedUrl     String?
  score           Decimal       @db.Decimal(5, 4)
  createdAt       DateTime      @default(now())
  track           Track         @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([verificationId, score])
  @@index([comparedTrackId])
}

model License {
  id              Int              @id @default(autoincrement())
  trackId         Int
  buyerId         Int
  type            LicenseType
  source          ProofSource      @default(UNCONFIGURED)
  purchaseRequest PurchaseRequest?
  licenseStatus   LicenseStatus    @default(PENDING_PAYMENT)
  currency        Currency         @default(UNKNOWN)
  tokenId         String?          @db.VarChar(78)
  purchaseTxHash  String?          @db.VarChar(66)
  issuedAt        DateTime?
  licenseTermsCid String?          @db.VarChar(255)
  price           Decimal          @db.Decimal(36, 18)
  createdAt       DateTime         @default(now())
  track           Track            @relation(fields: [trackId], references: [id])
  buyer           User             @relation(fields: [buyerId], references: [id])
  transactions    Transaction[]

  @@index([buyerId, createdAt])
  @@index([trackId, licenseStatus])
}

model Transaction {
  id                 Int                 @id @default(autoincrement())
  trackId            Int
  userId             Int
  licenseId          Int?
  source             ProofSource         @default(UNCONFIGURED)
  purchaseRequestId  Int?                @unique
  purchaseRequest    PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: Restrict)
  chainId            String?             @db.VarChar(78)
  blockNumber        BigInt?             @db.UnsignedBigInt
  transactionType    TransactionType     @default(LICENSE_PURCHASE)
  paymentReference   String?             @unique
  failureReason      String?             @db.Text
  confirmedAt        DateTime?
  currency           Currency            @default(UNKNOWN)
  revenueAllocations RevenueAllocation[]
  amount             Decimal             @db.Decimal(36, 18)
  status             TransactionStatus   @default(PENDING)
  txHash             String?
  createdAt          DateTime            @default(now())
  track              Track               @relation(fields: [trackId], references: [id])
  user               User                @relation(fields: [userId], references: [id])
  license            License?            @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([trackId, status])
  @@index([licenseId])
}

model MarketplaceListing {
  id               Int               @id @default(autoincrement())
  trackId          Int
  sellerId         Int
  price            Decimal           @db.Decimal(36, 18)
  currency         Currency
  status           ListingStatus     @default(PREPARING)
  licenseType      LicenseType       @default(COMMERCIAL)
  purchaseRequests PurchaseRequest[]
  // DB CHECK binds this to trackId for ACTIVE, NULL otherwise.
  activeTrackId    Int?              @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  track            Track             @relation(fields: [trackId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seller           User              @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([trackId, status])
  @@index([sellerId, createdAt])
  @@index([status, currency, price])
  @@index([status, createdAt])
}

model RevenueAllocation {
  id            Int         @id @default(autoincrement())
  transactionId Int
  userId        Int
  percentage    Decimal     @db.Decimal(5, 2)
  amount        Decimal     @db.Decimal(36, 18)
  currency      Currency
  // An allocation is only an estimate until external settlement is verified.
  confirmedAt   DateTime?
  createdAt     DateTime    @default(now())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([transactionId, userId])
  @@index([userId, currency, confirmedAt])
}

model RevenueWithdrawal {
  walletAddress    String?          @db.VarChar(42)
  id               Int              @id @default(autoincrement())
  userId           Int
  amount           Decimal          @db.Decimal(36, 18)
  currency         Currency
  status           WithdrawalStatus @default(PREPARING)
  paymentReference String?          @unique
  txHash           String?          @db.VarChar(66)
  failureReason    String?          @db.Text
  confirmedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, currency, status])
  @@index([userId, createdAt])
}

model MetadataSnapshot {
  id            Int                   @id @default(autoincrement())
  trackId       Int
  version       Int
  hash          String                @db.VarChar(64)
  document      Json
  status        PreparationStatus     @default(PREPARED)
  metadataCid   String?               @db.VarChar(255)
  audioCid      String?               @db.VarChar(255)
  errorCode     String?
  errorMessage  String?               @db.Text
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  track         Track                 @relation(fields: [trackId], references: [id], onDelete: Cascade)
  registrations RegistrationRequest[]

  @@unique([trackId, version])
  @@index([trackId, hash])
}

model RegistrationRequest {
  id                 Int                @id @default(autoincrement())
  trackId            Int
  metadataSnapshotId Int?
  nonce              String             @unique @db.VarChar(78)
  deadline           DateTime
  chainId            String             @db.VarChar(78)
  contractAddress    String?            @db.VarChar(42)
  status             RegistrationStatus @default(PENDING)
  source             ProofSource        @default(UNCONFIGURED)
  typedData          Json?
  signature          String?            @db.VarChar(132)
  txHash             String?            @db.VarChar(66)
  blockchainTrackId  String?            @db.VarChar(78)
  errorCode          String?
  errorMessage       String?            @db.Text
  confirmedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  track              Track              @relation(fields: [trackId], references: [id], onDelete: Cascade)
  metadataSnapshot   MetadataSnapshot?  @relation(fields: [metadataSnapshotId], references: [id], onDelete: Restrict)

  @@index([trackId, status])
}

model PurchaseRequest {
  id                   Int                @id @default(autoincrement())
  trackId              Int
  buyerId              Int
  listingId            Int
  licenseId            Int?               @unique
  buyerWalletAddress   String?             @db.VarChar(42)
  licenseType          LicenseType
  price                Decimal            @db.Decimal(36, 18)
  currency             Currency
  status               PurchaseStatus     @default(PENDING_PAYMENT)
  source               ProofSource        @default(UNCONFIGURED)
  preparation          Boolean            @default(false)
  idempotencyKey       String             @db.VarChar(100)
  activeBuyerTrackType String?            @unique @db.VarChar(100)
  contributorSnapshot  Json
  failureReason        String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  confirmedAt          DateTime?
  track                Track              @relation(fields: [trackId], references: [id], onDelete: Restrict)
  buyer                User               @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  listing              MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  license              License?           @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  transaction          Transaction?

  @@unique([buyerId, idempotencyKey])
  @@index([buyerId, createdAt])
}

model WalletChallenge {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  walletAddress String    @db.VarChar(42)
  nonce         String    @db.VarChar(64)
  message       String    @db.Text
  expiresAt     DateTime
  consumedAt    DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BlockchainEvent {
  id              Int       @id @default(autoincrement())
  chainId         String    @db.VarChar(78)
  transactionHash String    @db.VarChar(66)
  logIndex        Int
  contractAddress String    @db.VarChar(42)
  eventName       String    @db.VarChar(64)
  blockNumber     BigInt    @db.UnsignedBigInt
  blockHash       String    @db.VarChar(66)
  payload         Json
  processedAt     DateTime?
  error           String?   @db.Text
  attempts        Int       @default(0)
  @@unique([chainId, transactionHash, logIndex])
  @@index([chainId, processedAt, blockNumber])
}
model BlockchainCursor {
  chainId     String @id @db.VarChar(78)
  blockNumber BigInt @db.UnsignedBigInt
  blockHash   String @db.VarChar(66)
}
