{
  "name": "music-rights-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-chain-artifacts.cjs",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "test": "npm run build && node --test tests/*.test.cjs",
    "prisma:seed:example": "node prisma/seed-example.cjs",
    "test:local": "npm run build && node scripts/test-local-flow.cjs",
    "db:check": "node scripts/check-database.cjs",
    "prisma:deploy": "prisma migrate deploy",
    "blockchain:import": "node scripts/import-contract.cjs",
    "test:blockchain": "npm run build && node --test tests/blockchain-e2e.test.cjs",
    "local:setup": "node scripts/setup-local-service.cjs",
    "local:infra": "docker compose --env-file .env.services.local -f compose.local.yml up -d --wait",
    "local:chain": "node scripts/local-chain.cjs",
    "local:migrate": "node --env-file=.env.services.local node_modules/prisma/build/index.js migrate deploy",
    "dev:services": "node --env-file=.env.services.local --import tsx src/server.ts",
    "local:check": "npm run build && node scripts/check-services.cjs",
    "test:service": "npm run build && node scripts/test-service.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "ethers": "^6.17.0",
    "express": "^5.1.0",
    "google-auth-library": "^10.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.5.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^6.16.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  }
}
